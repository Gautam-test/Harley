# API server
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Database
# `pnpm dev` (apps/api) auto-boots an embedded Postgres at this URL — no Docker needed.
# To use an external Postgres instead: set EMBEDDED_DB=0 in env and point DATABASE_URL at it.
DATABASE_URL=postgresql://hdcpo:hdcpo_dev_password@localhost:55432/hd_cpo_marketplace?schema=public

# Redis
# mock://  → in-process (zero install) ioredis-mock — fine for local dev.
# redis:// → real Redis (production / shared dev environments).
REDIS_URL=mock://

# JWT — generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=dev-only-jwt-access-secret-please-replace-in-production-32chars
JWT_REFRESH_SECRET=dev-only-jwt-refresh-secret-please-replace-in-production-32chars
JWT_ACCESS_TTL_SECONDS=900
# 12 hours — production default. Dealer + admin sessions expire after
# this and the SPA shows a "Session timed out" banner on /login.
JWT_REFRESH_TTL_SECONDS=43200

# OTP token signing
OTP_VERIFIED_TOKEN_SECRET=dev-only-otp-token-secret-please-replace-32chars
OTP_VERIFIED_TOKEN_TTL_SECONDS=900

# PII encryption (32-byte hex)
PII_ENCRYPTION_KEY=dev-only-pii-key-please-replace-with-32-byte-hex-in-production

# Object storage (MinIO defaults from docker-compose; only needed for image uploads)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin_dev
S3_BUCKET=hd-cpo-assets

# SMS / OTP provider (MSG91 default per PRD Open Question 10)
SMS_PROVIDER=mock
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# Email provider
EMAIL_PROVIDER=mock
SENDGRID_API_KEY=
EMAIL_FROM=noreply@hd-cpo.local

# Torque DMS
TORQUE_MODE=mock
TORQUE_BASE_URL=
TORQUE_API_KEY=

# Google Maps (server-side geocoding)
GOOGLE_MAPS_API_KEY=

# Sentry — leave SENTRY_DSN blank to disable. When set, the API dynamic-imports
# `@sentry/node` (install with `pnpm --filter @hd-cpo/api add @sentry/node`).
# See apps/api/src/config/sentry.ts.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Set EMBEDDED_DB=0 to skip the embedded-postgres orchestrator (use an external DB).
# EMBEDDED_DB=0
