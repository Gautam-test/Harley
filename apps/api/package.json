{
  "name": "@hd-cpo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "dev:noembedded": "cross-env EMBEDDED_DB=0 tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:prod": "pnpm prisma:deploy && node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'lint-noop'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prisma:generate": "cross-env PRISMA_GENERATE_SKIP_AUTOINSTALL=1 prisma generate --schema=./prisma/schema.prisma",
    "prisma:migrate": "cross-env PRISMA_GENERATE_SKIP_AUTOINSTALL=1 prisma migrate dev --schema=./prisma/schema.prisma",
    "prisma:deploy": "cross-env PRISMA_GENERATE_SKIP_AUTOINSTALL=1 prisma migrate deploy --schema=./prisma/schema.prisma",
    "prisma:seed": "tsx ./prisma/seed.ts",
    "prisma:seed-extra": "tsx ./prisma/seed-extra.ts",
    "prisma:studio": "prisma studio --schema=./prisma/schema.prisma"
  },
  "dependencies": {
    "@hd-cpo/torque-client": "workspace:*",
    "@hd-cpo/types": "workspace:*",
    "@prisma/client": "5.22.0",
    "@types/pdfkit": "^0.17.6",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.18.0",
    "sharp": "^0.34.5",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.0.3",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@hd-cpo/config": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/ioredis-mock": "^8.2.7",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/swagger-ui-express": "^4.1.7",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "embedded-postgres": "18.3.0-beta.17",
    "ioredis-mock": "^8.13.1",
    "pino-pretty": "^13.0.0",
    "prisma": "5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
