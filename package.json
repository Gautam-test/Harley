{
  "name": "hd-cpo-marketplace",
  "private": true,
  "version": "0.1.0",
  "description": "Harley-Davidson Certified Pre-Owned Marketplace — monorepo",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck",
    "test:e2e:auth": "node e2e/auth-session-flow.mjs",
    "test:e2e:otp": "node e2e/info-gate-modal-strictmode.mjs",
    "test:e2e:regression": "pnpm test:e2e:auth && pnpm test:e2e:otp",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "prisma:generate": "pnpm --filter @hd-cpo/api prisma:generate",
    "prisma:migrate": "pnpm --filter @hd-cpo/api prisma:migrate",
    "prisma:seed": "pnpm --filter @hd-cpo/api prisma:seed",
    "prisma:studio": "pnpm --filter @hd-cpo/api prisma:studio"
  },
  "devDependencies": {
    "@hyzyla/pdfium": "^2.1.12",
    "pdfjs-dist": "4.10.38",
    "pnpm": "10.33.2",
    "prettier": "^3.4.2",
    "sharp": "^0.34.5",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": "20.x",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "@scarf/scarf",
      "@embedded-postgres/windows-x64",
      "@embedded-postgres/linux-x64",
      "@embedded-postgres/darwin-x64",
      "@embedded-postgres/darwin-arm64",
      "sharp"
    ]
  }
}
